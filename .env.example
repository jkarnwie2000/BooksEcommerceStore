# Server-side only (set these in Vercel > Project > Settings > Environment Variables).
# Never prefix them with REACT_APP_, or they will be bundled into the browser code.

# Stripe payments
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the Stripe webhook pointing at /api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin dashboard
ADMIN_PASSWORD=choose-a-strong-password

# Order confirmation emails: choose ONE way to send.
# Option A - Gmail (no domain needed). SMTP_PASS is a Google "app password".
SMTP_USER=yourstore@gmail.com
SMTP_PASS=abcdefghijklmnop
# Option B - Resend (needs a verified domain)
# RESEND_API_KEY=re_...
# EMAIL_FROM="Julius Gold's Library <orders@yourdomain.com>"

# Where new-order notifications go (defaults to SMTP_USER)
BUSINESS_EMAIL=

# Added automatically when the Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=
